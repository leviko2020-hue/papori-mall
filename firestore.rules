rules_version = '2';

// PAPORI 쇼핑몰 Firestore 보안 규칙
// 이 파일은 저장소 안에서 참고/버전관리용으로 보관하는 사본입니다.
// 실제로 적용하려면 Firebase 콘솔(console.firebase.google.com) > papori-mall 프로젝트
// > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣고 "게시(Publish)"를 눌러야 합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'paporimomo@gmail.com';
    }

    // 회원정보: 본인 또는 관리자만 읽고 쓸 수 있음
    match /members/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // 견적요청: 누구나(비회원 포함) 새로 접수할 수 있고, 조회/수정/삭제는 관리자만
    match /quoteRequests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 주문: 누구나(비회원 포함) 새로 접수할 수 있고, 조회/수정/삭제는 관리자만
    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 상품 가격/재고/이름/이미지 오버라이드: 누구나 읽을 수 있고(쇼핑몰 표시용), 쓰기는 관리자만
    match /productOverrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 관리자가 새로 등록한 상품: 누구나 읽을 수 있고, 쓰기는 관리자만
    match /customProducts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사이트 기본정보(상호/주소 등): 누구나 읽을 수 있고(푸터 표시용), 쓰기는 관리자만
    match /siteConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 그 외 문서는 기본적으로 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
